<trapd-configuration xmlns="http://xmlns.opennms.org/xsd/config/trapd" snmp-trap-address="<%= @config.snmp_trap_address %>" snmp-trap-port="<%= @config.snmp_trap_port %>" new-suspect-on-trap="<%= @config.new_suspect_on_trap %>" include-raw-message="<%= @config.include_raw_message %>" threads="<%= @config.threads %>" queue-size="<%= @config.queue_size %>" batch-size="<%= @config.batch_size %>" batch-interval="<%= @config.batch_interval %>"<%= @config.use_address_from_varbind.nil? ? '' : " use-address-from-varbind=\"#{@config.use_address_from_varbind}\"" %><%= @config.snmpv3_users.nil? || @config.snmpv3_users.empty? ? '/>' : '>' %>
<% @config.snmpv3_users.each do |user| -%>
  <snmpv3-user<%= user.id.nil? ? '' : " id=#{user.id.encode(:xml => :attr)}" %><%= user.engine_id.nil? ? '' : " engine-id=#{user.engine_id.encode(:xml => :attr)}" %><%= user.security_name.nil? ? '' : " security-name=#{user.security_name.encode(:xml => :attr)}" %><%= user.security_level.nil? ? '' : " security-level=#{user.security_level.to_s.encode(:xml => :attr)}" %><%= user.auth_protocol.nil? ? '' : " auth-protocol=#{user.auth_protocol.encode(:xml => :attr)}" %><%= user.auth_passphrase.nil? ? '' : " auth-passphrase=#{user.auth_passphrase.encode(:xml => :attr)}" %><%= user.privacy_protocol.nil? ? '' : " privacy-protocol=#{user.privacy_protocol.encode(:xml => :attr)}" %><%= user.privacy_passphrase.nil? ? '' : " privacy-passphrase=#{user.privacy_passphrase.encode(:xml => :attr)}" %> />
<% end -%>
<% if !@config.snmpv3_users.nil? && !@config.snmpv3_users.empty? -%>
</trapd-configuration>
<% end -%>
