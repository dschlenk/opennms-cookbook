<?xml version="1.0"?>
<!-- NOTE!!!!!!!!!!!!!!!!!!!
The order in which these services are specified is important - for example, Eventd
will need to come up last so that none of the event topic subcribers loose any event.

When splitting services to run on mutiple VMs, the order of the services should be
maintained
-->
<service-configuration xmlns="http://xmlns.opennms.org/xsd/config/vmmgr">
   <service enabled=<%= @manager.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Manager</name>
   </service>
   <service enabled=<%= @eventd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Eventd</name>
   </service>
   <service enabled=<%= @alarmd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Alarmd</name>
   </service>
   <service enabled=<%= @bsmd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Bsmd</name>
   </service>
   <service enabled=<%= @ticketer.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Ticketer</name>
   </service>
   <service enabled=<%= @correlator.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Correlator</name>
   </service>
   <service enabled=<%= @queued.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Queued</name>
   </service>
   <service enabled=<%= @actiond.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Actiond</name>
   </service>
   <service enabled=<%= @notifd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Notifd</name>
   </service>
   <service enabled=<%= @scriptd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Scriptd</name>
   </service>
   <service enabled=<%= @rtcd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Rtcd</name>
   </service>
   <service enabled=<%= @pollerd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Pollerd</name>
   </service>
   <service enabled=<%= @snmp_poller.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=SnmpPoller</name>
   </service>
   <service enabled=<%= @enlinkd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=EnhancedLinkd</name>
   </service>
   <service enabled=<%= @collectd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Collectd</name>
   </service>
   <service enabled=<%= @discovery.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Discovery</name>
   </service>
   <service enabled=<%= @vacuumd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Vacuumd</name>
   </service>
   <service enabled=<%= @translator.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=EventTranslator</name>
   </service>
   <service enabled=<%= @passive_statusd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=PassiveStatusd</name>
   </service>
   <service enabled=<%= @statsd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Statsd</name>
   </service>
   <service enabled=<%= @provisiond.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Provisiond</name>
   </service>
   <service enabled=<%= @ackd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Ackd</name>
   </service>
   <service enabled=<%= @jetty.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=JettyServer</name>
   </service>
   <service enabled=<%= @ksm.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=KarafStartupMonitor</name>
   </service>
   <service enabled=<%= @syslogd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Syslogd</name>
   </service>
   <service enabled=<%= @telemetryd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Telemetryd</name>
   </service>
   <service enabled=<%= @trapd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Trapd</name>
   </service>
   <service enabled=<%= @perspective_poller.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=PerspectivePoller</name>
   </service>
</service-configuration>
