<?xml version="1.0"?>
<!-- NOTE!!!!!!!!!!!!!!!!!!!
The order in which these services are specified is important - for example, Eventd
will need to come up last so that none of the event topic subcribers loose any event.

When splitting services to run on mutiple VMs, the order of the services should be
maintained
-->
<service-configuration xmlns="http://xmlns.opennms.org/xsd/config/vmmgr">
   <service enabled=<%= @manager.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Manager</name>
   </service>
   <service enabled=<%= @eventd.to_s.encode(:xml => :attr) %>>
      <name>OpenNMS:Name=Eventd</name>
   </service>
<% %w(Alarmd Bsmd Ticketer Correlator Queued Actiond Notifd Scriptd Rtcd Pollerd SnmpPoller EnhancedLinkd Collectd Discovery Vacuumd EventTranslator PassiveStatusd Statsd Provisiond Ackd JettyServer KarafStartupMonitor Syslogd Telemetryd Trapd PerspectivePoller).each do |d| -%>
   <service enabled=<%= "${env:CORE_SERVICE_#{d.upcase}_ENABLED|#{@services[d.downcase].to_s}}".encode(:xml => :attr) %>>
      <name>OpenNMS:Name=<%= d %></name>
   </service>
<% end -%>
</service-configuration>