<?xml version="1.0" encoding="UTF-8"?>
<opennms:reports
  xmlns:opennms="http://xmlns.opennms.org/xsd"
  xmlns="http://xmlns.opennms.org/xsd/reports"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://xmlns.opennms.org/xsd http://xmlns.opennms.org/xsd/reports/reports.xsd">
<% @config.reports.each do |report| -%>
  <report id="<%= report[:id] %>" type="<%= report[:type] %>">
    <logo><%= report[:logo].to_s.strip %></logo>
    <svg-template><%= report[:svg_template] ? "file:///opt/opennms/etc/reports/#{report[:svg_template].strip}" : "" %></svg-template>
    <pdf-template><%= report[:pdf_template] ? "file:///opt/opennms/etc/reports/#{report[:pdf_template].strip}" : "" %></pdf-template>
    <html-template><%= report[:html_template] ? "file:///opt/opennms/etc/reports/#{report[:html_template].strip}" : "" %></html-template>
    <parameters>
      <% (report[:parameters]['string_parms'] || []).each do |parm| -%>
        <string-parm name="<%= parm['name'] %>"
                     display-name="<%= parm['display_name'] %>"
                     input-type="<%= parm['input_type'] %>"
                     <% if parm['default'] && !parm['default'].to_s.empty? %>default="<%= parm['default'] %>"<% end %> />
      <% end -%>
      <% (report[:parameters]['date_parms'] || []).each do |parm| -%>
        <date-parm name="<%= parm['name'] %>"
                   display-name="<%= parm['display_name'] %>"
                   use-absolute-date="<%= parm['use_absolute_date'] ? 'true' : 'false' %>">
          <default-interval><%= parm['default_interval'] %></default-interval>
          <default-count><%= parm['default_count'] %></default-count>
          <default-time>
            <hours><%= parm.dig('default_time', 'hour').to_s.strip %></hours>
            <minutes><%= parm.dig('default_time', 'minute').to_s.strip %></minutes>
          </default-time>
        </date-parm>
      <% end -%>
      <% (report[:parameters]['int_parms'] || []).each do |parm| -%>
        <int-parm name="<%= parm['name'] %>"
                  display-name="<%= parm['display_name'] %>"
                  input-type="<%= parm['input_type'] || 'freeText' %>"
                  <% if parm['default'] && !parm['default'].to_s.empty? %>default="<%= parm['default'] %>"<% end %> />
      <% end -%>
    </parameters>
  </report>
<% end -%>
</opennms:reports>
