<?xml version="1.0" encoding="UTF-8"?>
<datasource-configuration xmlns:this="http://xmlns.opennms.org/xsd/config/opennms-datasources" 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
  xsi:schemaLocation="http://xmlns.opennms.org/xsd/config/opennms-datasources 
  http://www.opennms.org/xsd/config/opennms-datasources.xsd ">

  <connection-pool factory="org.opennms.core.db.HikariCPConnectionFactory"
<% @datasources['connection_pool'].each_with_index do |(k, v), i| -%>
    <%= Opennms::Helpers.snake_to_camel_lower(k) %>="<%= v %>"<%= i == @datasources['connection_pool'].size - 1 ? ' />' : '' %>
<% end -%>

<% @datasources.each_with_index do |(source, definition), index| -%>
  <% next if source == 'connection_pool' -%>
  <jdbc-data-source name="<%= source %>" 
  <% definition.each_with_index do |(k, v), i| -%>
    <% next if k == "connection_pool" -%>
                    <%= Opennms::Helpers.snake_to_kebab(k) %>="<%= v %>"<%= %w(database_name class_name).include?(k) ? ' ' : '' %><%= i == definition.size - 1 && definition['connection_pool'].nil? ? ' />' : (!definition['connection_pool'].nil? && i == definition.size - 2 ? '>' : '') %>
  <% end -%>
  <% if !definition['connection_pool'].nil? -%>
    <connection-pool <% definition['connection_pool'].each_with_index do |(k, v), i| -%><%= i == 0 ? Opennms::Helpers.snake_to_camel_lower(k) + '="' + v.to_s + '"' : (definition['connection_pool'].size == 1 ? ' />' : '') %><% next if i == 0 -%>
                     <%= Opennms::Helpers.snake_to_camel_lower(k) %>="<%= v %>"<%= definition['connection_pool'].size - 1 == i ? " />" : '' -%>
    <% end -%>

  </jdbc-data-source>
  <% end -%>
  <% if index != @datasources.size - 1 -%>
<%= source == 'opennms-admin' ? '  ' : '' %>
  <% end -%>
<% end -%>
</datasource-configuration>
