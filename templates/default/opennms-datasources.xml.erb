<?xml version="1.0" encoding="UTF-8"?>
<datasource-configuration xmlns:this="http://xmlns.opennms.org/xsd/config/opennms-datasources" 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
  xsi:schemaLocation="http://xmlns.opennms.org/xsd/config/opennms-datasources 
  http://www.opennms.org/xsd/config/opennms-datasources.xsd ">

  <connection-pool factory="org.opennms.core.db.HikariCPConnectionFactory"
<% @datasources['connection_pool'].each_with_index do |(k, v), index| -%>
  <% if index == @datasources['connection_pool'].size - 1 -%>
    <%= Opennms::Helpers.snake_to_camel_lower(k) %>="<%= v %>" />
  <% else -%>
    <%= Opennms::Helpers.snake_to_camel_lower(k) %>="<%= v %>"
  <% end -%>
<% end -%>

<% @datasources.each_with_index do |(source, definition), index| -%>
    <% next if source == 'connection_pool' -%>
  <jdbc-data-source name="<%= source %>" 
    <% definition.except('connection_pool').each_with_index do |(k, v), i| -%>
      <% if %w(database-name class-name).include?(Opennms::Helpers.snake_to_kebab(k)) -%>
        <% if i == definition.except('connection_pool').size - 1 && definition['connection_pool'].nil? -%>
                    <%= Opennms::Helpers.snake_to_kebab(k) %>="<%= v %>" />
        <% else -%>
                    <%= Opennms::Helpers.snake_to_kebab(k) %>="<%= v %>" 
        <% end -%>
      <% else -%>
        <% if i == definition.except('connection_pool').size - 1 && definition['connection_pool'].nil? -%>
                    <%= Opennms::Helpers.snake_to_kebab(k) %>="<%= v %>" />
        <% elsif i == definition.except('connection_pool').size - 1 -%>
                    <%= Opennms::Helpers.snake_to_kebab(k) %>="<%= v %>">
        <% else -%>
                    <%= Opennms::Helpers.snake_to_kebab(k) %>="<%= v %>"
        <% end -%>
      <% end -%>
    <% end -%>
    <% if !definition['connection_pool'].nil? -%>
      <% definition['connection_pool'].each_with_index do |(k, v), i| -%>
        <% if i == 0 -%>
    <connection-pool <%= Opennms::Helpers.snake_to_camel_lower(k) %>="<%= v %>"
        <% else -%>
          <% if i == definition['connection_pool'].size - 1 -%>
                     <%= Opennms::Helpers.snake_to_camel_lower(k) %>="<%= v %>" />
          <% else -%>
                     <%= Opennms::Helpers.snake_to_camel_lower(k) %>="<%= v %>"
          <% end -%>
        <% end -%>
      <% end -%>
  </jdbc-data-source>
    <% end -%>
  <% if index != @datasources.size - 1 -%>
<%= index > 1 ? '  ' : '' %>
  <% end -%>
<% end -%>
</datasource-configuration>
