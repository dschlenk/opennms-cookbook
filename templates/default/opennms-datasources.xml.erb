<?xml version="1.0" encoding="UTF-8"?>
<datasource-configuration xmlns:this="http://xmlns.opennms.org/xsd/config/opennms-datasources" 
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
  xsi:schemaLocation="http://xmlns.opennms.org/xsd/config/opennms-datasources 
  http://www.opennms.org/xsd/config/opennms-datasources.xsd ">

  <connection-pool idleTimeout="${env:OPENNMS_DATABASE_CONNECTION_IDLETIMEOUT|<%= @datasources['connection_pool']['idle_timeout'] %>}"
    loginTimeout="${env:OPENNMS_DATABASE_CONNECTION_LOGINTIMEOUT|<%= @datasources['connection_pool']['login_timeout'] %>}"
    minPool="${env:OPENNMS_DATABASE_CONNECTION_MINPOOL|<%= @datasources['connection_pool']['min_pool'] %>}"
    maxPool="${env:OPENNMS_DATABASE_CONNECTION_MAXPOOL|<%= @datasources['connection_pool']['max_pool'] %>}"
    maxSize="${env:OPENNMS_DATABASE_CONNECTION_MAXSIZE|<%= @datasources['connection_pool']['max_size'] %>}" />

  <jdbc-data-source name="opennms"
                    database-name="${env:OPENNMS_DBNAME|<%= @datasources['opennms']['database_name'] %>}"
                    url=<%= @datasources['opennms']['url'].encode(:xml => :attr) %>
                    user-name=<%= @datasources['opennms']['user_name'].encode(:xml => :attr) %>
                    password=<%= @datasources['opennms']['password'].encode(:xml => :attr) %> />

  <jdbc-data-source name="opennms-admin" 
                    database-name=<%= @datasources['opennms-admin']['database_name'].encode(:xml => :attr) %>
                    url=<%= @datasources['opennms-admin']['url'].encode(:xml => :attr) %>
                    user-name=<%= @datasources['opennms-admin']['user_name'].encode(:xml => :attr) %>
                    password=<%= @datasources['opennms-admin']['password'].encode(:xml => :attr) %>>
    <connection-pool idleTimeout="<%= @datasources['opennms-admin']['connection_pool']['idle_timeout'] %>"
                     minPool="<%= @datasources['opennms-admin']['connection_pool']['min_pool'] %>"
                     maxPool="<%= @datasources['opennms-admin']['connection_pool']['max_pool'] %>"
                     maxSize="<%= @datasources['opennms-admin']['connection_pool']['max_size'] %>" />
  </jdbc-data-source>
  
  <jdbc-data-source name="opennms-monitor" 
                    database-name=<%= @datasources['opennms-monitor']['database_name'].encode(:xml => :attr) %>
                    url=<%= @datasources['opennms-monitor']['url'].encode(:xml => :attr) %>
                    user-name=<%= @datasources['opennms-monitor']['user_name'].encode(:xml => :attr) %>
                    password=<%= @datasources['opennms-monitor']['password'].encode(:xml => :attr) %>>
    <connection-pool idleTimeout="<%= @datasources['opennms-monitor']['connection_pool']['idle_timeout'] %>"
                     minPool="<%= @datasources['opennms-monitor']['connection_pool']['min_pool'] %>"
                     maxPool="<%= @datasources['opennms-monitor']['connection_pool']['max_pool'] %>"
                     maxSize="<%= @datasources['opennms-monitor']['connection_pool']['max_size'] %>" />
  </jdbc-data-source>
</datasource-configuration>
